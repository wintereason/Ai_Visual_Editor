# Copy to .env.local and fill in from your Supabase project (Settings > API).
# With these unset the editor runs in local-only mode: no sign-in, no cloud sync.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Testing only: use the in-browser mock backend instead of Supabase.
# NEXT_PUBLIC_CLOUD=mock

# ---- AI (server-side only: NEVER prefix these with NEXT_PUBLIC_) ----
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5-5          # choose from your evaluation results (npm run eval -w @avc/ai)
# SUPABASE_SERVICE_ROLE_KEY=...       # lets the server verify sign-ins and charge credits. Server only. Needs migration 3.
# AI_RATE_PER_MINUTE=12

# ---- Safety checks on AI (server-only; on by default whenever AI is on) ----
# AI_MODERATION=off                      # only switch off deliberately
# AI_MODERATION_MODEL=claude-haiku-5-5   # a small, cheap model does the checking

# ---- Buying credits with Razorpay (server-only: never NEXT_PUBLIC_) ----
# RAZORPAY_KEY_ID=rzp_test_...           # the PUBLIC key id; test keys first
# RAZORPAY_KEY_SECRET=...                # SECRET. Never in the browser.
# RAZORPAY_WEBHOOK_SECRET=...            # SECRET. A different value, set on the webhook in the Razorpay dashboard.
# BILLING_PACKS=[{"id":"starter","label":"Starter","credits":50,"amountPaise":9900}]   # your real prices; the built-in ones are placeholders

# ---- Your business details, shown on the platform's own Terms / Privacy / Refund pages ----
# NEXT_PUBLIC_BUSINESS_NAME=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_BUSINESS_ADDRESS=
# NEXT_PUBLIC_LEGAL_COUNTRY=India
